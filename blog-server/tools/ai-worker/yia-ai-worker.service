[Unit]
Description=Yia isolated project code worker
After=network-online.target docker.service yia-blog.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B /opt/yia-ai-worker/worker.py
EnvironmentFile=/etc/yia-ai-worker/worker.env
Restart=on-failure
RestartSec=10
UMask=0077
Nice=10
CPUQuota=25%
MemoryMax=160M
MemorySwapMax=160M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yia-ai-worker
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
